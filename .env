# Server Configuration
PORT=3000

# Security Configuration
# You must include this key in the request headers as "x-api-key"
API_KEY=my_secure_super_secret_key_123

# Webhook Configuration
# Leave empty if you do not want to use webhooks
# Example: WEBHOOK_URL=http://localhost:8000/api/whatsapp-webhook
WEBHOOK_URL=

# WhatsApp Sessions Parent Directory Name
SESSIONS_DIR=wa_sessions
